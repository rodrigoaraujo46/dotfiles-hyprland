{
	"margin-left": 20,
	"margin-top": 12,
	"margin-right": 20,
	"height": 40,
	"reload_style_on_change": true,
	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["group/media"],
	"modules-right": [
		"tray",
		"custom/separator",
		"group/brightness",
		"group/audio",
		"custom/separator",
		"memory",
		"battery",
		"custom/separator",
		"group/clock"
	],
	"hyprland/workspaces": {
		"on-click": "activate",
		"sort-by-number": true,
		"format": "{icon}",
		"format-icons": {
			"1": "󰊠",
			"2": "󰈹"
		}
	},
	"custom/separator": {
		"format": "|",
		"tooltip": false
	},
	"group/media": {
		"orientation": "horizontal",
		"modules": ["image#album-art", "mpris"]
	},
	"mpris": {
		"format": "{title}  {artist}",
		"format-paused": "{title}  {artist}",
		"max-length": 40,
		"dynamic-len": 10,
		"player": "spotify",
		"on-scroll-up": "playerctl --player=spotify volume 0.05+",
		"on-scroll-down": "playerctl --player=spotify volume 0.05-"
	},
	"image#album-art": {
		"exec": "~/.config/waybar/album_art.sh",
		"size": 22,
		"interval": 5
	},
	"group/clock": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"transition-left-to-right": true
		},
		"modules": ["clock", "clock#date"]
	},
	"clock#date": {
		"interval": 1,
		"format": "󰇙 {:%d/%m}",
		"tooltip": true,
		"tooltip-format": "<tt><small>{calendar}</small></tt>"
	},
	"clock": {
		"interval": 1,
		"format": "{:%H:%M}",
		"tooltip": false,
		"tooltip-format": "<tt><small>{calendar}</small></tt>"
	},
	"tray": {
		"icon-size": 15,
		"spacing": 10
	},
	"memory": {
		"interval": 30,
		"format": "  {used:0.1f}GB",
		"on-click": "ghostty +new-window -e btop"
	},
	"battery": {
		"bat": "BAT1",
		"interval": 60,
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon}  {capacity}%",
		"format-icons": ["", "", "", "", ""],
		"max-length": 25
	},
	"group/brightness": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"transition-left-to-right": true
		},
		"modules": ["backlight", "backlight/slider"]
	},
	"backlight": {
		"scroll-step": 1,
		"device": "intel_backlight",
		"format": "{icon}",
		"tooltip-format": "{percent}%",
		"format-icons": ["", ""]
	},
	"backlight/slider": {
		"min": 0,
		"max": 100
	},
	"group/audio": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"transition-left-to-right": true
		},
		"modules": ["pulseaudio", "pulseaudio/slider"]
	},
	"pulseaudio": {
		"format": "{icon}",
		"format-muted": "󰖁",
		"format-icons": { "default": ["", ""] },
		"scroll-step": 1,
		"tooltip-format": "{volume}%",
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"on-click-middle": "uwsm app -- gtk-launch wiremix",
		"ignored-sinks": ["Easy Effects Sink"],
		"max-volume": 150
	},
	"pulseaudio/slider": {
		"min": 0,
		"max": 150
	}
}
